{
  "permissions": {
    "deny": [
      "Bash(sudo rm -rf /*)",
      "Bash(sudo rm -rf /etc*)",
      "Bash(sudo rm -rf /var*)",
      "Bash(sudo rm -rf /usr*)",
      "Bash(sudo rm -rf /bin*)",
      "Bash(sudo rm -rf /sbin*)",
      "Bash(mkfs*)",
      "Bash(dd if=/dev/zero*)",
      "Bash(dd if=/dev/random*)",
      "Bash(chmod -R 777 /*)",
      "Bash(chown -R * /*)"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "autoUpdatesChannel": "latest",
  "skipAutoPermissionPrompt": true,
  "tui": "fullscreen"
}
