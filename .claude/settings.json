{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_MOUSE": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(sudo rm -rf /*)",
      "Bash(sudo rm -rf /etc*)",
      "Bash(sudo rm -rf /var*)",
      "Bash(sudo rm -rf /usr*)",
      "Bash(sudo rm -rf /bin*)",
      "Bash(sudo rm -rf /sbin*)",
      "Bash(mkfs*)",
      "Bash(dd if=/dev/zero*)",
      "Bash(dd if=/dev/random*)",
      "Bash(chmod -R 777 /*)",
      "Bash(chown -R * /*)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(*| sh)",
      "Bash(*| bash)",
      "Bash(curl * | *)",
      "Bash(wget * | *)",
      "Bash(npm publish*)",
      "Bash(docker rm*)",
      "Bash(docker rmi*)",
      "Bash(docker system prune*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf /*)"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/convert-clipboard.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "sandbox": {
    "enabled": false
  },
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true
}
